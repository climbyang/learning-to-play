# Copy to server/.env and fill in. Never commit .env.
LG_TV_IP=192.168.1.xxx         # TV's LAN IP (reserve it in the router)
LG_TV_MAC=                      # TV's MAC (Wi-Fi or wired, whichever it uses) for /on via Wake-on-LAN
LG_CLIENT_KEY=                  # printed by `uv run ltp pair` after accepting on the TV
TELEGRAM_BOT_TOKEN=             # from @BotFather (a NEW bot dedicated to this project)
TELEGRAM_CHAT_ID=               # parent chat id(s), comma separated
# Quiz service bearer tokens, "device:token" comma separated (device name = TV, e.g. tv1).
# Generate: python -c "import secrets;print(secrets.token_urlsafe(24))"
QUIZ_TOKENS=
